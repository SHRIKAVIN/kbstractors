# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Push Notifications (Web Push / VAPID) — see README "Push Notifications" section
# Client build-time key (safe to expose)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# Server-only secrets — set these in the Vercel dashboard, not in a committed .env file
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# APP_PUSH_WEBHOOK_SECRET=   # optional; falls back to CRON_SECRET for the DB trigger