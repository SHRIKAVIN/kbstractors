{
  "name": "KBS Tractors",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/pending-reminders",
      "schedule": "0 4 * * *"
    }
  ]
}
